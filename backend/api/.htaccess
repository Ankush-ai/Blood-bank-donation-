<IfModule mod_rewrite.c>
    RewriteEngine On
    
    # If the requested filename exists, simply serve it.
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Otherwise, pass everything to index.php
    RewriteRule ^ index.php [QSA,L]
</IfModule>
